# Ignore any files with 'api_key' in the filename (case-sensitive)
*api_key*
# --- Node / TypeScript / Vite ---
**/node_modules/
**/dist/
**/build/
**/.vite/
**/.cache/
**/.parcel-cache/
**/coverage/
**/.nyc_output/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Environment / secrets ---
.env
.env.*
!.env.example
!**/.env.example

# Repo-specific secrets (do not commit)
EODHD/API TOKEN
thetadata/credit.txt
thetadata/creds.txt

# Local credentials (do not commit)
mcp_servers/bitwarden/figma_id_password

# Playwright persisted auth/session state (do not commit)
mcp_servers/playwright_mcp/.auth/

# Google API key files (do not commit)
ai_agent_plan/**/google_api_key*
ai_agent_plan/**/google_api_key/**

# --- Local databases (SQLite) ---
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# Known local runtime DB in this repo
terminal/backend/backend/data/app.db

# Headed-Chrome scraper profile (runtime state — cookies/cache, not source)
terminal/backend/backend/data/investing-browser-profile/

# Local ad-hoc maintenance scripts
terminal/backend/test_*.mjs

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- OS junk ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Local scratch / generated artifacts ---
tmp/

# AI preflight ACK markers (local only)
hook_tools/.preflight_ack/
